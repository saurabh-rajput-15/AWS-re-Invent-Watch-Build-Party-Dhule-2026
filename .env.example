# ==============================================================
# AWS re:Invent Dhule 2026 - Production Environment Variables
# ==============================================================

# Server Network Port
PORT=5000

# Production URLs (Client Frontend and Server API)
FRONTEND_URL=https://reinvent.awssbgdhule.in
API_URL=https://api.reinvent.awssbgdhule.in

# Admin Passcode (Used to log into /admin portal and /scanner camera)
ADMIN_KEY=your_secure_admin_passcode

# JSON Web Token Secret for Admin Sessions
JWT_SECRET=your_jwt_secret_signing_key_2026

# Brevo (Sendinblue) Transactional Email API for Tickets
BREVO_MAIL_API=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@reinvent.awssbgdhule.in
BREVO_SENDER_NAME=AWS re:Invent Dhule 2026

# Supabase Cloud Database Connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AWS Builder Center Autonomous Agent Session
# (Extracted from builder.aws.com cookies for automated RSVP verification)
AWS_BUILDER_SESSION_COOKIE="builder-session-token=...; awsccc=...; cwr_u=...;"
AWS_BUILDER_CSRF_TOKEN="your_aws_csrf_token_string"
AWS_BUILDER_EVENT_ID="c8a38d77-8262-34c4-b744-ea8dfb7b35a6"
