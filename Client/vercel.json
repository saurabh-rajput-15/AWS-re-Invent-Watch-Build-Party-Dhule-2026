{
  "headers": [
    {
      "source": "/(admin|scanner|ticket|ticketid=.*|api/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.reinvent.awssbgdhule.in/api/:match*"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/codeofconduct",
      "destination": "/codeofconduct/index.html"
    },
    {
      "source": "/code-of-conduct",
      "destination": "/codeofconduct/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
